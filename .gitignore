# Referencias locales — NUNCA se suben
_referencias/

# Las fotos originales del celular se quedan en la compu: al repo público solo suben los
# recortes de 720 px que usa el juego (assets/fotos/). Para regenerarlos hay que volver a
# poner los originales acá y correr tools/prepare_photos.py.
assets/source/fotos/

# Lo mismo con la música: los .mp3 que salen de Gemini pesan 27 MB y se quedan acá; al repo sube
# lo que arma tools/preparar_musica.py (assets/musica/).
assets/source/musica/

